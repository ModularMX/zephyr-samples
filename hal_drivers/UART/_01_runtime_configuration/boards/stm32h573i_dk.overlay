/ {
    aliases {
        uart = &usart1;
    };  
};

/*configure the usart 1. ST already ships pins configuration
definition as part of the hal_smt32 module, refer to stm32h573iikxq-pinctrl.dtsi*/
&usart2 {
    status = "okay";
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
};